# SQLite database (local). For PostgreSQL change provider in schema.prisma and set:
# DATABASE_URL="postgresql://user:password@localhost:5432/childrenbook"
DATABASE_URL="file:./dev.db"

# Secret used to sign admin session JWTs. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""

# Initial admin account (created by `npm run db:seed`)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
