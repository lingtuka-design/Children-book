{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "children-book",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-12",
  "r2_buckets": [
    {
      "binding": "BOOK_ASSETS",
      "bucket_name": "children-book-assets"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "children-book-db",
      "database_id": "cb107d4b-bad5-439c-ad47-1e3b52cfb5e7"
    }
  ]
}
