{
  "routes": [
    {
      "routePath": "/api/assets/:key*",
      "mountPath": "/api/assets",
      "method": "GET",
      "module": [
        "api/assets/[[key]].ts:onRequestGet"
      ]
    },
    {
      "routePath": "/api/assets/:key*",
      "mountPath": "/api/assets",
      "method": "POST",
      "module": [
        "api/assets/[[key]].ts:onRequestPost"
      ]
    },
    {
      "routePath": "/api/books/:id*",
      "mountPath": "/api/books",
      "method": "DELETE",
      "module": [
        "api/books/[[id]].ts:onRequestDelete"
      ]
    },
    {
      "routePath": "/api/books/:id*",
      "mountPath": "/api/books",
      "method": "GET",
      "module": [
        "api/books/[[id]].ts:onRequestGet"
      ]
    },
    {
      "routePath": "/api/books/:id*",
      "mountPath": "/api/books",
      "method": "POST",
      "module": [
        "api/books/[[id]].ts:onRequestPost"
      ]
    },
    {
      "routePath": "/api/orders/:id*",
      "mountPath": "/api/orders",
      "method": "DELETE",
      "module": [
        "api/orders/[[id]].ts:onRequestDelete"
      ]
    },
    {
      "routePath": "/api/orders/:id*",
      "mountPath": "/api/orders",
      "method": "PATCH",
      "module": [
        "api/orders/[[id]].ts:onRequestPatch"
      ]
    },
    {
      "routePath": "/api/styles/:id*",
      "mountPath": "/api/styles",
      "method": "PUT",
      "module": [
        "api/styles/[[id]].ts:onRequestPut"
      ]
    },
    {
      "routePath": "/api/health",
      "mountPath": "/api",
      "method": "GET",
      "module": [
        "api/health.ts:onRequestGet"
      ]
    },
    {
      "routePath": "/api/orders",
      "mountPath": "/api",
      "method": "GET",
      "module": [
        "api/orders.ts:onRequestGet"
      ]
    },
    {
      "routePath": "/api/orders",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/orders.ts:onRequestPost"
      ]
    },
    {
      "routePath": "/api/seed",
      "mountPath": "/api",
      "method": "POST",
      "module": [
        "api/seed.ts:onRequestPost"
      ]
    },
    {
      "routePath": "/api/styles",
      "mountPath": "/api",
      "method": "GET",
      "module": [
        "api/styles.ts:onRequestGet"
      ]
    }
  ],
  "baseURL": "/"
}